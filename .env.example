# Sao chep thanh .env (da nam trong .gitignore) roi dien gia tri that.
# Ung dung doc .env o thu muc goc repo hoac thu muc dang chay.

# --- Bat buoc ---
DB_PASSWORD=
# Chuoi ngau nhien >= 32 ky tu, vd: openssl rand -base64 48
JWT_SECRET=

# --- CSDL & Redis (mac dinh: localhost) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tripmind
DB_USER=postgres
REDIS_HOST=localhost
REDIS_PORT=6379
SERVER_PORT=8088

# --- Dich vu ngoai ---
# Google Places API (New). De trong thi chi dung catalog trong CSDL.
GOOGLE_PLACES_API_KEY=
USE_MOCK_PLACES=false

# Tro ly AI qua 9router; LLM_MODEL la danh sach model cach nhau dau phay.
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=http://localhost:20128/v1
# LLM_COMPLETIONS_PATH=/chat/completions

# --- Van hanh ---
# Email (phan tach bang dau phay) duoc tao tai khoan ADMIN luc khoi dong
ADMIN_EMAILS=
# Mat khau (>= 12 ky tu) cho tai khoan ADMIN chua ton tai. Trong thi bo qua tao ADMIN.
ADMIN_BOOTSTRAP_PASSWORD=
# Khong co xac minh email: ai cung dang ky truoc duoc mot email trong ADMIN_EMAILS.
# Chi dat true sau khi da kiem tra chu tai khoan, de nang quyen tai khoan da ton tai.
ADMIN_BOOTSTRAP_PROMOTE_EXISTING=false
API_RATE_LIMIT_PER_MINUTE=120

# --- Bao mat HTTP ---
# Origin duoc goi API tu trinh duyet (phan tach bang dau phay, khong dung *)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Swagger UI / OpenAPI: nen dat false o production
SWAGGER_ENABLED=true
# Dat native/framework CHI KHI chay sau reverse proxy tin cay (de lay IP that tu X-Forwarded-For)
FORWARD_HEADERS_STRATEGY=none
