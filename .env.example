# Sao chep thanh .env (da nam trong .gitignore) roi dien gia tri that.
# Ung dung doc .env o thu muc goc repo hoac thu muc dang chay.

# --- Bat buoc ---
DB_PASSWORD=
# Chuoi ngau nhien >= 32 ky tu, vd: openssl rand -base64 48
JWT_SECRET=

# --- CSDL & Redis (mac dinh: localhost) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tripmind
DB_USER=postgres
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Dich vu ngoai ---
# Google Places API (New). De trong thi chi dung catalog trong CSDL.
GOOGLE_PLACES_API_KEY=
USE_MOCK_PLACES=false
# Gemini qua lop tuong thich OpenAI. De trong thi tro ly AI tra 503 AI_NOT_CONFIGURED.
GEMINI_API_KEY=
